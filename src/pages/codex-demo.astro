---
import { getBlogCollection } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { formatTimelineDate, getBlogSlug, serializeJsonForScript, sortBlogPosts } from '@/utils/blog'

export const prerender = true

type CodexDemoTimelinePost = {
  id: string
  data: {
    description: string
    publishDate: Date
    tags: string[]
    title: string
  }
}

function getCodexDemoTimelineItems<T extends CodexDemoTimelinePost>(posts: readonly T[]) {
  return sortBlogPosts(posts).map((post) => {
    const slug = getBlogSlug(post.id)

    return {
      date: formatTimelineDate(post.data.publishDate),
      description: post.data.description,
      href: `/blog/${slug}`,
      tags: post.data.tags,
      title: post.data.title,
      updateText: `新增了「${post.data.title}」文章`
    }
  })
}

const posts = await getBlogCollection()
const timelineItems = getCodexDemoTimelineItems(posts)
const timelineJson = serializeJsonForScript(timelineItems)
const sceneDepth = Math.max(1400, timelineItems.length * 105)
const finishDepth = -(timelineItems.length + 1) * 94
const sceneNodes = timelineItems.map((item, index) => {
  const progress = timelineItems.length <= 1 ? 0 : index / (timelineItems.length - 1)
  const angle = progress * Math.PI * 5

  return {
    hue: Math.round(156 + (index % 5) * 31),
    index,
    title: `${item.date} ${item.title}`,
    x: Math.round(Math.sin(angle) * 190),
    y: Math.round(Math.cos(angle * 0.7) * 72),
    z: -index * 94
  }
})

const meta = {
  description: '以 3D 動態時間軸展示故事調製所新增的文章',
  title: 'Codex Demo'
}
---

<PageLayout {meta} highlightColor='#7EF4CC'>
  <main class='codex-demo'>
    <section class='demo-stage' aria-labelledby='codex-demo-title'>
      <div class='scene-panel' aria-hidden='true'>
        <div class='scene-grid'></div>
        <div class='scene-camera' id='scene-camera'>
          <div class='scene-world' id='scene-world' style={`--scene-depth:${sceneDepth}px`}>
            <i class='scene-rail'></i>
            {
              sceneNodes.map((node) => (
                <i
                  class='scene-node'
                  data-scene-node
                  data-entry-index={node.index}
                  style={`--node-x:${node.x}px;--node-y:${node.y}px;--node-z:${node.z}px;--node-hue:${node.hue};--node-delay:${node.index * -120}ms`}
                  title={node.title}
                />
              ))
            }
            <i class='scene-finish' style={`--finish-z:${finishDepth}px`}></i>
          </div>
        </div>
        <div class='scene-readout'>
          <time id='scene-date' datetime={timelineItems[0]?.date}>{timelineItems[0]?.date}</time>
          <strong id='scene-title'>{timelineItems[0]?.title ?? '尚無文章'}</strong>
        </div>
      </div>

      <div class='demo-content'>
        <header class='demo-hero'>
          <p class='demo-kicker'>codex-demo</p>
          <h1 id='codex-demo-title'>故事發射軌道</h1>
          <p>
            每一篇文章都會從內容集合自動生成一個節點；新增 Markdown 或 MDX
            文章後，這條時間軸會在下次建置時跟著更新。
          </p>
          <div class='demo-stats' aria-label='文章統計'>
            <span>{timelineItems.length}</span>
            <small>篇文章</small>
          </div>
        </header>

        <section class='timeline-panel' aria-label='文章新增時間軸'>
          {
            timelineItems.length === 0 ? (
              <p class='empty-state'>目前還沒有文章。</p>
            ) : (
              <ol class='timeline-list'>
                {timelineItems.map((item, index) => (
                  <li>
                    <a
                      class='timeline-entry'
                      data-timeline-entry
                      data-entry-index={index}
                      href={item.href}
                    >
                      <time datetime={item.date}>{item.date}</time>
                      <strong>{item.updateText}</strong>
                      <span>{item.description}</span>
                      <em>{item.tags.slice(0, 3).join(' / ')}</em>
                    </a>
                  </li>
                ))}
              </ol>
            )
          }
        </section>
      </div>
    </section>
    <script id='timeline-data' type='application/json' is:inline set:html={timelineJson} />
  </main>

  <script>
    type TimelineSceneItem = {
      date: string
      description: string
      href: string
      tags: string[]
      title: string
      updateText: string
    }

    const dataElement = document.querySelector<HTMLScriptElement>('#timeline-data')
    const entries = [...document.querySelectorAll<HTMLElement>('[data-timeline-entry]')]
    const nodes = [...document.querySelectorAll<HTMLElement>('[data-scene-node]')]
    const camera = document.querySelector<HTMLElement>('#scene-camera')
    const dateEl = document.querySelector<HTMLTimeElement>('#scene-date')
    const titleEl = document.querySelector<HTMLElement>('#scene-title')
    const timelineItems = JSON.parse(dataElement?.textContent || '[]') as TimelineSceneItem[]
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const coarsePointer = window.matchMedia('(pointer: coarse)').matches

    if (camera && timelineItems.length > 0) {
      const sceneCamera = camera
      let activeIndex = 0
      let pointerX = 0
      let pointerY = 0
      let lastTime = performance.now()
      let frame = 0
      const current = { rotateX: 8, rotateY: -12, z: 0 }
      const target = { rotateX: 8, rotateY: -12, z: 0 }

      function setActiveIndex(nextIndex: number) {
        activeIndex = Math.max(0, Math.min(timelineItems.length - 1, nextIndex))
        const item = timelineItems[activeIndex]
        const progress = timelineItems.length <= 1 ? 0 : activeIndex / (timelineItems.length - 1)

        target.rotateY = -14 + Math.sin(progress * Math.PI * 2.2) * 12
        target.rotateX = 8 + Math.cos(progress * Math.PI * 1.6) * 5
        target.z = activeIndex * 94

        entries.forEach((entry, index) => {
          entry.toggleAttribute('data-active', index === activeIndex)
        })
        nodes.forEach((node, index) => {
          node.toggleAttribute('data-active', index === activeIndex)
        })

        if (dateEl) {
          dateEl.dateTime = item.date
          dateEl.textContent = item.date
        }
        if (titleEl) {
          titleEl.textContent =
            item.title.length > 18 ? `${item.title.slice(0, 18)}...` : item.title
        }
      }

      entries.forEach((entry, index) => {
        entry.addEventListener('pointerenter', () => setActiveIndex(index))
        entry.addEventListener('focus', () => setActiveIndex(index))
      })

      const observer = new IntersectionObserver(
        (observedEntries) => {
          const visible = observedEntries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]

          if (visible?.target instanceof HTMLElement) {
            setActiveIndex(Number(visible.target.dataset.entryIndex || 0))
          }
        },
        { root: document.querySelector('.timeline-panel'), threshold: [0.45, 0.7, 0.95] }
      )
      entries.forEach((entry) => observer.observe(entry))

      window.addEventListener('pointermove', (event) => {
        pointerX = (event.clientX / Math.max(1, window.innerWidth) - 0.5) * 2
        pointerY = (event.clientY / Math.max(1, window.innerHeight) - 0.5) * 2
      })

      function render(now: number) {
        const dt = Math.min((now - lastTime) / 1000, 0.05)
        lastTime = now
        const alpha = reducedMotion || coarsePointer ? 1 : 1 - Math.exp(-dt * 8)
        const px = reducedMotion || coarsePointer ? 0 : pointerX
        const py = reducedMotion || coarsePointer ? 0 : pointerY

        current.rotateX += (target.rotateX - py * 3 - current.rotateX) * alpha
        current.rotateY += (target.rotateY + px * 5 - current.rotateY) * alpha
        current.z += (target.z - current.z) * alpha

        sceneCamera.style.transform = `rotateX(${current.rotateX.toFixed(3)}deg) rotateY(${current.rotateY.toFixed(3)}deg) translate3d(0, 0, ${current.z.toFixed(3)}px)`

        frame = requestAnimationFrame(render)
      }

      setActiveIndex(0)
      if (!reducedMotion && !coarsePointer) {
        frame = requestAnimationFrame(render)
      } else {
        sceneCamera.style.transform = 'rotateX(8deg) rotateY(-12deg) translate3d(0, 0, 0)'
      }

      document.addEventListener('astro:before-swap', () => {
        cancelAnimationFrame(frame)
        observer.disconnect()
      })
    }
  </script>

  <style>
    :global(body) {
      overflow-x: hidden;
    }

    .codex-demo {
      margin-top: -0.5rem;
    }

    .demo-stage {
      background:
        radial-gradient(circle at 18% 20%, rgba(126, 244, 204, 0.18), transparent 27rem),
        radial-gradient(circle at 86% 24%, rgba(255, 93, 158, 0.15), transparent 24rem),
        radial-gradient(circle at 52% 96%, rgba(255, 209, 102, 0.13), transparent 22rem), #05060a;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 0.5rem;
      box-shadow: 0 28px 90px rgba(0, 0, 0, 0.34);
      color: #f8fafc;
      min-height: min(880px, calc(100dvh - 7rem));
      overflow: hidden;
      position: relative;
    }

    .scene-panel {
      bottom: 0;
      left: 0;
      overflow: hidden;
      pointer-events: none;
      position: absolute;
      top: 0;
      width: min(56rem, 68%);
    }

    .scene-panel::after {
      background: linear-gradient(90deg, rgba(5, 6, 10, 0), rgba(5, 6, 10, 0.7));
      content: '';
      inset: 0;
      left: auto;
      position: absolute;
      width: 30%;
    }

    .scene-grid {
      background-image:
        linear-gradient(rgba(126, 244, 204, 0.13) 1px, transparent 1px),
        linear-gradient(90deg, rgba(126, 244, 204, 0.13) 1px, transparent 1px);
      background-size: 5.6rem 5.6rem;
      bottom: -16%;
      filter: drop-shadow(0 0 18px rgba(126, 244, 204, 0.2));
      height: 58%;
      left: -12%;
      opacity: 0.44;
      position: absolute;
      right: 6%;
      transform: perspective(700px) rotateX(68deg);
      transform-origin: 50% 100%;
    }

    .scene-camera {
      height: 100%;
      left: 42%;
      perspective: 900px;
      position: absolute;
      top: 50%;
      transform-style: preserve-3d;
      width: 1px;
      will-change: transform;
    }

    .scene-world,
    .scene-node,
    .scene-rail,
    .scene-finish {
      position: absolute;
      transform-style: preserve-3d;
    }

    .scene-world {
      left: 0;
      top: 0;
    }

    .scene-rail {
      background: linear-gradient(
        180deg,
        rgba(126, 244, 204, 0.85),
        rgba(255, 209, 102, 0.45),
        rgba(255, 93, 158, 0.55)
      );
      border-radius: 999px;
      box-shadow: 0 0 36px rgba(126, 244, 204, 0.45);
      height: var(--scene-depth);
      left: -1px;
      top: -3rem;
      transform: rotateX(90deg) translateZ(-2rem);
      transform-origin: 50% 0;
      width: 2px;
    }

    .scene-node {
      --node-color: hsl(var(--node-hue) 88% 66%);
      background: var(--node-color);
      border-radius: 50%;
      box-shadow:
        0 0 0 0.45rem hsl(var(--node-hue) 88% 66% / 0.1),
        0 0 1.4rem hsl(var(--node-hue) 88% 66% / 0.8),
        0 0 4rem hsl(var(--node-hue) 88% 66% / 0.28);
      height: 0.82rem;
      left: 0;
      top: 0;
      transform: translate3d(var(--node-x), var(--node-y), var(--node-z));
      transition:
        opacity 180ms ease,
        scale 180ms ease;
      width: 0.82rem;
    }

    .scene-node::before,
    .scene-node::after {
      border: 1px solid hsl(var(--node-hue) 88% 66% / 0.48);
      border-radius: 50%;
      content: '';
      inset: -0.92rem;
      position: absolute;
      transform: rotateX(70deg);
    }

    .scene-node::after {
      inset: -1.55rem;
      opacity: 0.36;
      transform: rotateY(74deg);
    }

    .scene-node[data-active] {
      scale: 1.7;
    }

    .scene-finish {
      background: rgba(255, 255, 255, 0.82);
      border-radius: 50%;
      box-shadow:
        0 0 2rem rgba(255, 255, 255, 0.46),
        0 0 7rem rgba(126, 244, 204, 0.28);
      height: 1rem;
      transform: translate3d(0, 0, var(--finish-z));
      width: 1rem;
    }

    .scene-readout {
      background: rgba(5, 6, 10, 0.58);
      border: 1px solid rgba(126, 244, 204, 0.28);
      border-radius: 0.5rem;
      bottom: clamp(1.25rem, 5vw, 3rem);
      box-shadow: 0 20px 58px rgba(0, 0, 0, 0.28);
      display: grid;
      gap: 0.35rem;
      left: clamp(1.25rem, 4vw, 4.5rem);
      max-width: min(24rem, 42vw);
      padding: 0.9rem 1rem;
      position: absolute;
      z-index: 1;
    }

    .scene-readout time {
      color: #7ef4cc;
      font-family:
        ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .scene-readout strong {
      color: #fff;
      font-size: 1.08rem;
      line-height: 1.35;
    }

    .demo-content {
      display: grid;
      gap: clamp(1.25rem, 4vw, 4rem);
      grid-template-columns: minmax(0, 0.82fr) minmax(21rem, 0.72fr);
      min-height: inherit;
      padding: clamp(1.25rem, 4vw, 4.5rem);
      position: relative;
      z-index: 2;
    }

    .demo-hero {
      align-self: start;
      max-width: 34rem;
      padding-top: clamp(1rem, 7vh, 5rem);
    }

    .demo-kicker {
      color: #7ef4cc;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      margin: 0 0 0.9rem;
      text-transform: uppercase;
    }

    .demo-hero h1 {
      color: #fff;
      font-size: clamp(2.6rem, 8vw, 5.8rem);
      font-weight: 800;
      letter-spacing: 0;
      line-height: 0.92;
      margin: 0;
      text-wrap: balance;
    }

    .demo-hero p:not(.demo-kicker) {
      color: rgba(248, 250, 252, 0.76);
      font-size: clamp(1rem, 1.8vw, 1.18rem);
      line-height: 1.8;
      margin: 1.5rem 0 0;
      max-width: 32rem;
    }

    .demo-stats {
      align-items: end;
      border-left: 3px solid #ffd166;
      display: flex;
      gap: 0.7rem;
      margin-top: 1.8rem;
      padding-left: 1rem;
    }

    .demo-stats span {
      color: #ffd166;
      font-size: 3rem;
      font-weight: 800;
      line-height: 0.9;
    }

    .demo-stats small {
      color: rgba(248, 250, 252, 0.72);
      font-weight: 700;
      padding-bottom: 0.12rem;
    }

    .timeline-panel {
      align-self: center;
      max-height: min(680px, calc(100dvh - 11rem));
      overflow: auto;
      padding-right: 0.4rem;
      scrollbar-color: rgba(126, 244, 204, 0.75) rgba(255, 255, 255, 0.08);
    }

    .timeline-list {
      display: grid;
      gap: 0.9rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .timeline-entry {
      background: rgba(8, 12, 18, 0.74);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 0.5rem;
      box-shadow:
        inset 0 1px rgba(255, 255, 255, 0.08),
        0 18px 45px rgba(0, 0, 0, 0.22);
      color: #f8fafc;
      display: grid;
      gap: 0.45rem;
      padding: 1rem 1.05rem;
      text-decoration: none;
      transform: perspective(900px) rotateX(0deg) translateZ(0);
      transition:
        background 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease,
        transform 180ms ease;
    }

    .timeline-entry:hover,
    .timeline-entry:focus-visible,
    .timeline-entry[data-active] {
      background: rgba(12, 23, 26, 0.94);
      border-color: rgba(126, 244, 204, 0.72);
      box-shadow:
        inset 0 1px rgba(255, 255, 255, 0.14),
        0 24px 64px rgba(126, 244, 204, 0.14);
      color: #fff;
      outline: none;
      transform: perspective(900px) rotateX(2deg) translateY(-2px) translateZ(28px);
    }

    .timeline-entry time {
      color: #7ef4cc;
      font-family:
        ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .timeline-entry strong {
      color: #fff;
      font-size: 1rem;
      line-height: 1.45;
    }

    .timeline-entry span {
      color: rgba(248, 250, 252, 0.72);
      display: -webkit-box;
      font-size: 0.9rem;
      line-height: 1.65;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .timeline-entry em {
      color: #ffd166;
      font-size: 0.78rem;
      font-style: normal;
      font-weight: 700;
      line-height: 1.4;
    }

    .empty-state {
      color: rgba(248, 250, 252, 0.76);
      margin: 0;
    }

    @media (max-width: 820px) {
      .demo-stage {
        min-height: auto;
      }

      .scene-panel {
        bottom: auto;
        height: 50dvh;
        opacity: 0.42;
        right: 0;
        width: 100%;
      }

      .scene-readout {
        display: none;
      }

      .demo-content {
        grid-template-columns: 1fr;
        padding: 1.25rem;
      }

      .demo-hero {
        min-height: 50dvh;
        padding: 8vh 0 0;
      }

      .demo-hero h1 {
        font-size: clamp(2.5rem, 16vw, 4.8rem);
      }

      .timeline-panel {
        max-height: none;
        overflow: visible;
        padding-right: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .scene-node,
      .timeline-entry {
        transition: none;
      }
    }
  </style>
</PageLayout>
