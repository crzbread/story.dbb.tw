---
import { getImage } from 'astro:assets'

import { getBlogCollection } from 'astro-pure/server'
import { normalizeBlogPost, sortBlogPosts } from '@/utils/blog'

// 讀取全部文章（build 時執行）：之後新增文章、重新 build 就會自動出現在時間軸上
const allPosts = await getBlogCollection()
const posts = sortBlogPosts(allPosts.map(normalizeBlogPost)).reverse() // 由舊到新

const items = await Promise.all(
  posts.map(async (post) => {
    let cover: string | null = null
    if (post.data.heroImage?.src) {
      const img = await getImage({ src: post.data.heroImage.src, width: 720, format: 'webp' })
      cover = img.src
    }
    return {
      title: post.data.title,
      description: post.data.description,
      date: post.data.publishDate.toISOString().slice(0, 10),
      tags: post.data.tags ?? [],
      url: `/blog/${post.id}`,
      cover
    }
  })
)

// 1×1 透明 GIF 佔位：真正的封面由前端依攝影機距離漸進載入
const coverPlaceholder =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7'

// 每個「年 / 月」的第一篇文章旁邊放一個懸浮月份標記
const markers: { label: string; index: number }[] = []
let lastKey = ''
items.forEach((it, i) => {
  const key = it.date.slice(0, 7)
  if (key !== lastKey) {
    lastKey = key
    const [y, m] = key.split('-')
    markers.push({ label: `${y} · ${Number(m)} 月`, index: i })
  }
})
---

<html lang='zh-TW'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover' />
    <title>Fable Demo · 3D 故事時間軸</title>
    <meta
      name='description'
      content='story.dbb.tw 的 3D 立體文章時間軸，捲動即可穿越每一篇故事的誕生時刻。'
    />
    <link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png' />
    <link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon-16x16.png' />
    <meta name='theme-color' content='#05060e' />
    <noscript>
      <style>
        /* 無 JS：退回扁平清單（html 前綴為了蓋過後載入的主要樣式） */
        html #fd-stage {
          position: static;
          perspective: none;
          overflow: visible;
        }
        html #fd-vignette,
        html #fd-floor,
        html .fd-marker,
        html #fd-hint,
        html #fd-play,
        html #fd-progress,
        html #fd-hud-bottom,
        html #fd-spacer,
        html .fd-cover {
          display: none;
        }
        html #fd-world {
          position: static;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 28px;
          padding: 100px 16px 70px;
        }
        html #fd-world > * {
          position: static;
          transform: none !important;
          margin: 0;
        }
        html .fd-title {
          width: min(640px, 90vw);
        }
        html .fd-title h1 {
          font-size: 44px;
        }
      </style>
    </noscript>
  </head>

  <body>
    <!-- 3D 舞台（固定滿版，捲動由下方 spacer 撐出） -->
    <div id='fd-stage'>
      <div id='fd-world'>
        <div id='fd-floor'></div>

        <!-- 開場標題 -->
        <div class='fd-title' id='fd-intro'>
          <p class='fd-title-kicker'>story.dbb.tw</p>
          <h1>故事時間軸</h1>
          <p class='fd-title-sub'>FABLE DEMO — 捲動，穿越每一篇故事誕生的時刻</p>
        </div>

        <!-- 文章卡片 -->
        {
          items.map((it, i) => (
            <a
              class='fd-card'
              href={it.url}
              data-index={i}
              data-date={it.date}
              data-title={it.title}
            >
              {it.cover && (
                <img
                  class='fd-cover'
                  src={coverPlaceholder}
                  data-src={it.cover}
                  alt={it.title}
                  decoding='async'
                />
              )}
              <div class='fd-card-body'>
                <p class='fd-date'>
                  <span class='fd-dot' />
                  {it.date} · 新增了
                </p>
                <h2 class='fd-card-title'>《{it.title}》</h2>
                <p class='fd-desc'>{it.description}</p>
                <p class='fd-tags'>
                  {it.tags.map((t) => (
                    <span class='fd-tag'>#{t}</span>
                  ))}
                </p>
              </div>
            </a>
          ))
        }

        <!-- 月份標記 -->
        {
          markers.map((m) => (
            <div class='fd-marker' data-index={m.index}>
              {m.label}
            </div>
          ))
        }

        <!-- 終點 -->
        <div class='fd-title fd-end' id='fd-end'>
          <h1>未完待續⋯</h1>
          <p class='fd-title-sub'>之後每一篇新文章，都會自動出現在這條時間軸上</p>
          <p class='fd-title-kicker'>共 {items.length} 篇故事</p>
        </div>
      </div>

      <!-- 電影暗角（真實元素才能確實 pointer-events: none，偽元素會攔截點擊） -->
      <div id='fd-vignette' aria-hidden='true'></div>
    </div>

    <!-- HUD -->
    <header id='fd-hud-top'>
      <a id='fd-back' href='/'>← story.dbb.tw</a>
      <button id='fd-play' type='button'>▶ 自動運鏡</button>
    </header>
    <footer id='fd-hud-bottom'>
      <p id='fd-readout'>&nbsp;</p>
      <p id='fd-counter'>&nbsp;</p>
    </footer>
    <div id='fd-progress'><i id='fd-progress-bar'></i></div>
    <p id='fd-hint'>SCROLL ↓ 開始飛行</p>

    <!-- 撐出捲動高度 -->
    <div id='fd-spacer'></div>

    <style is:global>
      :root {
        --fd-bg: #05060e;
        --fd-cyan: #6be5ff;
        --fd-violet: #a78bfa;
        --fd-text: #eef1ff;
        --fd-muted: #9aa3c7;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html {
        scroll-behavior: auto;
      }
      body {
        background:
          radial-gradient(1200px 700px at 70% -10%, rgba(103, 76, 205, 0.22), transparent 60%),
          radial-gradient(900px 600px at 15% 110%, rgba(38, 129, 178, 0.18), transparent 60%),
          var(--fd-bg);
        color: var(--fd-text);
        font-family:
          system-ui,
          -apple-system,
          'PingFang TC',
          'Noto Sans TC',
          'Microsoft JhengHei',
          sans-serif;
        overflow-x: hidden;
      }

      /* ---------- 3D 舞台 ---------- */
      #fd-stage {
        position: fixed;
        inset: 0;
        perspective: 1100px;
        perspective-origin: 50% 46%;
        overflow: hidden;
      }
      #fd-world {
        position: absolute;
        left: 50%;
        top: 50%;
        transform-style: preserve-3d;
        will-change: transform;
      }
      #fd-world > * {
        position: absolute;
        left: 0;
        top: 0;
        transform-style: preserve-3d;
      }

      /* 地板網格 */
      #fd-floor {
        width: 9000px;
        margin-left: -4500px;
        background-image:
          repeating-linear-gradient(
            0deg,
            rgba(122, 146, 255, 0.13) 0 1.5px,
            transparent 1.5px 130px
          ),
          repeating-linear-gradient(
            90deg,
            rgba(122, 146, 255, 0.13) 0 1.5px,
            transparent 1.5px 130px
          );
        -webkit-mask-image: radial-gradient(ellipse 46% 44% at 50% 50%, #000 30%, transparent 78%);
        mask-image: radial-gradient(ellipse 46% 44% at 50% 50%, #000 30%, transparent 78%);
      }

      /* 星星、光暈、光軌（由 JS 產生） */
      .fd-star {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #cfe6ff;
        box-shadow: 0 0 6px rgba(160, 210, 255, 0.9);
      }
      .fd-nebula {
        width: 900px;
        height: 900px;
        margin: -450px 0 0 -450px;
        border-radius: 50%;
        pointer-events: none;
      }
      .fd-seg {
        height: 2px;
        margin-top: -1px;
        background: linear-gradient(
          90deg,
          rgba(107, 229, 255, 0.05),
          rgba(107, 229, 255, 0.55),
          rgba(167, 139, 250, 0.05)
