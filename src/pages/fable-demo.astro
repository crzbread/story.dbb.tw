        box-shadow: 0 0 12px rgba(107, 229, 255, 0.35);
      }
      .fd-seg.fd-spur {
        height: 1.5px;
        opacity: 0.45;
        box-shadow: 0 0 8px rgba(107, 229, 255, 0.25);
      }
      .fd-node {
        width: 10px;
