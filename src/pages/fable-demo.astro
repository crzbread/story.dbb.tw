        background: var(--fd-cyan);
        box-shadow:
          0 0 10px var(--fd-cyan),
          0 0 26px rgba(107, 229, 255, 0.6);
      }

      /* ---------- 開場 / 結尾標題 ---------- */
      .fd-title {
        width: 640px;
        margin-left: -320px;
        text-align: center;
        pointer-events: none;
      }
      .fd-title h1 {
        font-size: 84px;
        font-weight: 800;
        letter-spacing: 0.12em;
        background: linear-gradient(120deg, var(--fd-cyan), #fff 45%, var(--fd-violet));
        -webkit-background-clip: text;
        background-clip: text;
